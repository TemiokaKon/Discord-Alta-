{
  "name": "alta52",
  "version": "3.0.0",
  "description": "Alta52 - Современный мессенджер в стиле Ruby Discord",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "init-db": "node server/config/database.js",
    "migrate": "node server/config/database.js",
    "deploy": "bash deploy.sh",
    "pm2": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop alta52",
    "pm2:restart": "pm2 restart alta52",
    "pm2:logs": "pm2 logs alta52",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\""
  },
  "keywords": [
    "discord",
    "chat",
    "webrtc",
    "messenger",
    "ruby",
    "glassmorphism"
  ],
  "author": "Alta52 Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
